# Variables de entorno necesarias para producción.
# Copiar como .env para desarrollo local.

# Render proporciona esta variable automáticamente
# al vincular una base de datos PostgreSQL.
# En local se deja vacía para usar SQLite.
DATABASE_URL=

# Intervalo en minutos entre escaneos automáticos.
SCAN_INTERVAL_MINUTES=60

# Credenciales del bot de Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

